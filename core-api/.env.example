# Server Configuration
NODE_ENV=development
PORT=4000

# Security
SERVICE_SECRET=your-super-secret-shared-value-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=1h

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bhm_db

# Legacy System Configuration (Budget Health API)
BH_SCHEME=your-scheme-name
BH_API_KEY=your-api-key
LEGACY_API_URL=https://budgethealth.webportal.co.zw/api/v2
LEGACY_SOAP_ENDPOINT=https://legacy-system.example.com/soap
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=legacy_db
LEGACY_DB_USER=legacy_user
LEGACY_DB_PASSWORD=legacy_password

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=https://your-worker.workers.dev
